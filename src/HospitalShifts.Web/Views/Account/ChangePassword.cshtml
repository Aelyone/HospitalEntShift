@{ ViewBag.Title = "تغییر رمز"; }
<form method="post" class="card narrow">@Html.AntiForgeryToken()
  <h2>تغییر رمز عبور</h2>
  @if (User.HasClaim(AppAuth.MustChangeClaim, "1")) { <p class="warn">پیش از ادامه باید رمز اولیه را تغییر دهید.</p> }
  <label>رمز فعلی <input name="current" type="password" required /></label>
  <label>رمز جدید <input name="next" type="password" required minlength="8" /><span class="help">حداقل ۸ کاراکتر؛ ترکیب حروف و عدد توصیه می‌شود.</span></label>
  <label>تکرار رمز جدید <input name="repeat" type="password" required /></label>
  <button>ذخیره</button>
</form>
